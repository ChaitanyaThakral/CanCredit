SELECT
    loan_type,
    education_level,
    credit_risk_segment,
    gender,
    income_type,
    COUNT(*) AS total_applications,
    SUM(default_flag) AS total_defaults,
    ROUND(AVG(default_flag) * 100, 2) AS default_rate_pct,
